root = true

[*]
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

# UTF-8 com BOM: o PowerShell 7 lê sem ele, mas o BOM mantém os acentos dos textos
# da janela se o script for aberto no Windows PowerShell 5.1.
[*.{ps1,psm1}]
charset = utf-8-bom

[*.{md,json,yml,yaml}]
charset = utf-8
indent_size = 2
